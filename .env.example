# =========================================================
#  JVI Carga & Serviços — variáveis de ambiente
#  Preencher no Netlify: Site settings > Environment variables
#  NÃO fazer commit deste ficheiro com valores reais.
#  Copiar para `.env` e preencher (o `.env` está no .gitignore).
# =========================================================

# ---------- 1. E-mail (Resend — plano grátis 3 000 e-mails/mês) ----------
# Criar chave em https://resend.com/api-keys
RESEND_API_KEY=re_COLOQUE_AQUI

# Remetente. Enquanto não tiver domínio verificado, use:
#   JVI Orcamentos <onboarding@resend.dev>
# Com domínio verificado:
#   Orcamentos <orcamentos@seudominio.com>
EMAIL_DE=JVI Orcamentos <onboarding@resend.dev>

# Para quem vão os pedidos
EMAIL_PARA=jvicargaservicos@gmail.com


# ---------- 2. Google Sheets ----------
# 2.1 Criar a folha: https://sheets.google.com  -> "Pedidos"
# 2.2 Na primeira folha, criar uma aba chamada "Pedidos"
# 2.3 O ID está no URL entre /d/ e /edit
#     Ex.: https://docs.google.com/spreadsheets/d/1AbCdEfGhIjKlMnOp/edit  ->  SHEET_ID=1AbCdEfGhIjKlMnOp
SHEET_ID=COLEQUE_AQUI

# 2.4 Criar conta de serviço:
#     Google Cloud Console > IAM & Admin > Service Accounts > New
#     Criar chave JSON e colar o conteúdo inteiro aqui, numa só linha,
#     com as aspas escapes (\").
#     Depois: partilhar a folha com o e-mail da conta de serviço
#     (o que termina em @<projecto>.iam.gserviceaccount.com)
#     com permissão de "Editor".
GOOGLE_SERVICE_ACCOUNT_JSON={}


# ---------- 3. Google Maps / direcções — NÃO PRECISA DE CHAVE ----------
#
# O botão "Como chegar à JVI" (Fase 7A) usa o link público de direcções
# do Google Maps, que é gratuito e não exige conta:
#
#   https://www.google.com/maps/dir/?api=1&destination=<destino>&travelmode=driving
#
# Por isso NÃO há variável de ambiente para a Fase 7, e não se cria uma.
#
# O que ficaria para um dia, COM uma API key do Google (billing
# activado, e chamada server-side — nunca no browser):
#
#   GOOGLE_MAPS_API_KEY=AIza...   # Directions API, para a Fase 7B
#
# A Fase 7B é o aviso de que o cliente está a chegar, com a posição e a
# hora de chegada estimada, para a JVI ligar. Está DESACTIVADA: sem
# `duration_in_traffic` não há estimativa de viagem, e sem estimativa
# não há como saber que o cliente está a 5 minutos. Ver
# `docs/decisoes.md` (D16).


# ---------- 4. Contactos ----------
#
# NÃO são lidos pelo site. O site é estático, sem passo de build, e não
# injeta variáveis de ambiente no HTML: os contactos vivem em
# `index.html` (secção Contactos, botões flutuantes, JSON-LD) e em
# `JVI_WHATSAPP` em `js/orcamento.js`, que é o número para onde vão as
# mensagens do formulário.
#
# Se um dia quiser mudar o número, mexa NESSES sítios. Estas linhas são
# apenas registo do que está em uso — e é por isso que estão comentadas.
# Ativas, seriam linhas mortas que induzem em erro.
#
#   # WhatsApp / Telefone — o ÚNICO número da empresa, confirmado pelo cliente
#   WHATSAPP=258878066265

